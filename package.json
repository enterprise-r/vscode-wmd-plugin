{
  "name": "wmd-preview",
  "displayName": "Workcard Preview",
  "description": "Preview .w.md workcards, the Markdown format for reliable AI workflows, as cards, forms, go/nogo gates and records.",
  "version": "0.1.1",
  "publisher": "enterprise-r",
  "author": {
    "name": "Enterprise-R",
    "email": "info@enterprise-r.com",
    "url": "https://www.enterprise-r.com"
  },
  "license": "GPL-3.0-only",
  "homepage": "https://www.enterprise-r.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/enterprise-r/vscode-wmd-plugin.git"
  },
  "bugs": {
    "url": "https://github.com/enterprise-r/vscode-wmd-plugin/issues",
    "email": "info@enterprise-r.com"
  },
  "icon": "images/icon.png",
  "galleryBanner": {
    "color": "#120320",
    "theme": "dark"
  },
  "qna": false,
  "pricing": "Free",
  "keywords": [
    "workcard",
    "w.md",
    "markdown",
    "preview",
    "ai",
    "workflow",
    "agents",
    "enterprise",
    "forms",
    "records"
  ],
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Visualization"
  ],
  "contributes": {
    "markdown.previewStyles": [
      "./dist/ui.css",
      "./dist/style.css"
    ],
    "markdown.previewScripts": [
      "./dist/wmd.js"
    ]
  },
  "scripts": {
    "build": "npx --yes esbuild@0.25 media/wmd.js media/ui.css media/style.css --minify --target=chrome122 --outdir=dist",
    "watch": "npm run build -- --watch=forever",
    "vscode:prepublish": "npm run build"
  }
}
